{
  "name": "troyorganiccleaners",
  "version": "1.0.0",
  "private": true,
  "description": "Static site for Troy Organic Cleaners.",
  "scripts": {
    "build:css": "sass css/style.scss css/style.css --source-map",
    "watch:css": "sass --watch css/style.scss:css/style.css",
    "dev:admin": "npm run dev --prefix admin",
    "build:admin": "npm run build --prefix admin",
    "test": "node --test tests/*.test.cjs && npm test --prefix admin",
    "test:db": "supabase test db",
    "test:browser": "playwright test",
    "build": "npm run build:css && npm run build:admin && node scripts/build-site.cjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sammyl720/troyorganiccleaners.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/sammyl720/troyorganiccleaners/issues"
  },
  "homepage": "https://github.com/sammyl720/troyorganiccleaners#readme",
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "jsdom": "^26.1.0",
    "sass": "^1.99.0"
  }
}
